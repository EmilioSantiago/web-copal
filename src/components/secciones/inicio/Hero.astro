---
/**
 * Hero del inicio: la entrada de Copal y su gran lámpara tejida.
 *
 * - "COPAL" enorme en Newsreader: empieza en la noche y cruza hacia la foto.
 * - Un detalle de las lámparas, enmarcado en naranja, se superpone (collage).
 * - La firma: la hoja cuyas elipses aparecen como brasas (HojaBrasas).
 * - "Se enciende" sin afectar el LCP: la foto se pinta desde el primer
 *   cuadro y una capa oscura (velo-encender) se desvanece en 0.9 s.
 * - Con prefers-reduced-motion no hay animación. Todo es CSS.
 */
import Foto from '../../ui/Foto.astro';
import HojaBrasas from '../../ui/HojaBrasas.astro';
import ReservarButton from '../../reserva/ReservarButton.astro';
import entrada from '../../../assets/photos/entrada/entrada-copal.webp';
import lampara from '../../../assets/photos/entrada/entrada-copal-2.webp';
import { SITE } from '../../../config/site';
import type { Lang } from '../../../i18n/routes';
import { pathFor, useTranslations } from '../../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-titulo" data-oculta-reservar-fijo data-fondo="noche">
	<div class="hero-foto velo-encender">
		<Foto
			src={entrada}
			alt={t('inicio.hero.alt')}
			sizes="(min-width: 64rem) 62vw, 100vw"
			prioridad
			class="hero-img"
		/>
	</div>

	<div class="hero-detalle marco marco--abajo-izq" aria-hidden="true">
		<Foto src={lampara} alt="" sizes="15vw" class="hero-detalle-img" />
	</div>

	<div class="hero-texto">
		<HojaBrasas class="hero-hoja" />
		<h1 id="hero-titulo" class="hero-nombre voz-marca">{SITE.name}</h1>
		<p class="hero-lema italica">{t('inicio.lema')}</p>
		<div class="hero-acciones">
			<ReservarButton lang={lang} />
			<a class="hero-visitanos" href={pathFor('visitanos', lang)}>{t('nav.visitanos')}</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: grid;
		min-height: 100svh;
		background-color: var(--c-noche);
		isolation: isolate;
		overflow: hidden;
	}

	/* ── Foto: a sangre ── */
	.hero-foto {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	/* Absoluta: llena su caja sin empujar la altura del hero. */
	.hero-foto :global(.hero-img) {
		position: absolute;
		inset: 0;
	}

	.hero-foto :global(.foto-img) {
		object-position: 50% 40%;
	}

	/* Velo para leer el texto sobre la foto (celular). */
	.hero-foto::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			var(--c-noche) 4%,
			rgb(18 14 11 / 0.72) 40%,
			rgb(18 14 11 / 0.1) 75%,
			rgb(18 14 11 / 0.35) 100%
		);
	}

	/* ── Detalle enmarcado: solo escritorio ── */
	.hero-detalle {
		display: none;
	}

	/* ── Texto ── */
	.hero-texto {
		align-self: end;
		display: grid;
		justify-items: start;
		gap: var(--e-4);
		padding: calc(var(--alto-header) + var(--e-6)) var(--margen-lateral)
			calc(var(--e-8) + var(--seguro-abajo));
	}

	.hero-hoja {
		--alto-hoja: clamp(4rem, 3rem + 4vw, 7rem);
		margin-block-end: var(--e-4);
	}

	/* COPAL enorme: en escritorio cruza de la noche a la lámpara. */
	.hero-nombre {
		font-size: clamp(4.5rem, 1rem + 17vw, 15rem);
		line-height: 0.82;
		letter-spacing: -0.02em;
		text-shadow: 0 0.04em 0.4em rgb(18 14 11 / 0.6);
	}

	.hero-lema {
		max-width: 20ch;
		font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.4rem);
		line-height: 1.12;
		color: var(--texto);
	}

	.hero-acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--e-4) var(--e-6);
		margin-block-start: var(--e-4);
	}

	.hero-visitanos {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--texto);
	}

	.hero-visitanos:hover {
		color: var(--c-farol);
	}

	/* ── Escritorio: texto a la izquierda, foto a sangre a la derecha ── */
	@media (min-width: 64rem) {
		.hero-foto {
			inset: 0 0 0 auto;
			width: 62%;
		}

		.hero-foto::after {
			background: linear-gradient(to right, var(--c-noche) 0%, rgb(18 14 11 / 0.35) 30%, transparent 60%);
		}

		.hero-texto {
			align-self: center;
			padding-block-end: var(--e-7);
		}

		.hero-detalle {
			display: block;
			position: absolute;
			inset-inline-start: 34%;
			inset-block-end: var(--e-7);
			z-index: 1;
			width: 15vw;
			aspect-ratio: 1;
		}

		.hero-detalle :global(.hero-detalle-img) {
			width: 100%;
			height: 100%;
		}
	}
</style>
