---
/**
 * Índice de áreas: Cocina, Bar y Wine bar, cada nombre en su propia voz.
 * Las líneas separan entradas de un índice (estructura, no adorno).
 * Con cursor, la miniatura gira un poco y la foto "se enciende".
 */
import Foto from '../../ui/Foto.astro';
import cocina from '../../../assets/photos/cocina/platillos/fuertes/pesca.webp';
import bar from '../../../assets/photos/bar/bebidas/chintextle.webp';
import wineBar from '../../../assets/photos/wine-bar/espacios/wine-espacio-1.webp';
import type { ImageMetadata } from 'astro';
import type { Lang, RouteKey } from '../../../i18n/routes';
import { pathFor, useTranslations, type UIKey } from '../../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const areas: { route: RouteKey; voz: string; titulo: UIKey; texto: UIKey; alt: UIKey; foto: ImageMetadata }[] = [
	{ route: 'cocina', voz: 'voz-cocina', titulo: 'nav.cocina', texto: 'inicio.cocina.texto', alt: 'inicio.cocina.alt', foto: cocina },
	{ route: 'bar', voz: 'voz-bar', titulo: 'nav.bar', texto: 'inicio.bar.texto', alt: 'inicio.bar.alt', foto: bar },
	{ route: 'wineBar', voz: 'voz-wine', titulo: 'nav.wineBar', texto: 'inicio.wineBar.texto', alt: 'inicio.wineBar.alt', foto: wineBar },
];
---

<section class="indice" aria-labelledby="indice-titulo" data-fondo="noche">
	<h2 id="indice-titulo" class="sr-only">{t('inicio.adelantos.titulo')}</h2>
	<ul role="list">
		{
			areas.map((a) => (
				<li class="indice-fila enciende">
					<h3 class={`indice-nombre ${a.voz}`}>
						<a href={pathFor(a.route, lang)}>{t(a.titulo)}</a>
					</h3>
					<p>{t(a.texto)}</p>
					<div class="indice-foto">
						<Foto src={a.foto} alt={t(a.alt)} sizes="(min-width: 64rem) 14rem, 30vw" class="indice-img" />
					</div>
				</li>
			))
		}
	</ul>
</section>

<style>
	.indice {
		max-width: var(--ancho-max);
		margin-inline: auto;
		padding: var(--e-9) var(--margen-lateral);
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.indice-fila {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--e-3) var(--e-5);
		padding-block: var(--e-6);
		border-block-start: 1px solid var(--linea);
	}

	.indice-fila:last-child {
		border-block-end: 1px solid var(--linea);
	}

	.indice-nombre {
		font-size: clamp(3rem, 1.5rem + 7vw, 8.5rem);
	}

	.indice-nombre a {
		color: var(--texto);
		text-decoration: none;
		transition: color var(--duracion) var(--curva);
	}

	.indice-nombre a:hover {
		color: var(--c-farol);
	}

	.indice-fila p {
		grid-column: 1;
		max-width: 36ch;
		color: var(--texto-suave);
	}

	.indice-foto {
		grid-column: 2;
		grid-row: 1 / span 2;
		width: clamp(5.5rem, 3rem + 10vw, 14rem);
		aspect-ratio: 3 / 4;
		transition: transform 0.5s var(--curva);
	}

	.indice-foto :global(.indice-img) {
		width: 100%;
		height: 100%;
	}

	@media (hover: hover) and (pointer: fine) {
		.indice-fila:hover .indice-foto {
			transform: rotate(-3deg) scale(1.06);
		}
	}

	@media (min-width: 64rem) {
		.indice-fila {
			grid-template-columns: minmax(0, 7fr) minmax(0, 4fr) auto;
		}

		.indice-fila p {
			grid-column: 2;
			grid-row: 1;
		}

		.indice-foto {
			grid-column: 3;
			grid-row: 1;
		}
	}
</style>
