---
/**
 * Encabezado de las páginas internas: el nombre del área en su propia voz
 * (Ultra para Cocina, Big Shoulders para Bar, itálica para Wine bar,
 * Newsreader para Contacto) y una entrada breve.
 * Con foto, la imagen va a sangre (es el LCP: carga con prioridad).
 */
import Foto from '../ui/Foto.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	titulo: string;
	entrada: string;
	/** Clase de voz: voz-cocina, voz-bar, voz-wine o voz-marca. */
	voz: string;
	foto?: { src: ImageMetadata; alt: string };
}

const { titulo, entrada, voz, foto } = Astro.props;
---

<header class:list={['cabecera', { 'cabecera--foto': foto }]} data-oculta-reservar-fijo>
	{
		foto && (
			<div class="cabecera-foto velo-encender">
				<Foto src={foto.src} alt={foto.alt} sizes="100vw" prioridad class="cabecera-img" />
			</div>
		)
	}
	<div class="cabecera-texto">
		<h1 class={`cabecera-titulo ${voz}`}>{titulo}</h1>
		<p class="cabecera-entrada">{entrada}</p>
		<slot />
	</div>
</header>

<style>
	.cabecera {
		position: relative;
		display: grid;
		isolation: isolate;
		overflow: hidden;
		padding: calc(var(--alto-header) + var(--e-8)) var(--margen-lateral) var(--e-8);
	}

	.cabecera--foto {
		min-height: 88svh;
		align-items: end;
	}

	.cabecera-foto {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.cabecera-foto :global(.cabecera-img) {
		position: absolute;
		inset: 0;
	}

	/* Velo inferior solo donde va el texto: la foto queda a plena luz arriba. */
	.cabecera-foto::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--c-noche) 2%, rgb(18 14 11 / 0.7) 32%, transparent 62%);
	}

	.cabecera-texto {
		display: grid;
		gap: var(--e-5);
		width: 100%;
		max-width: var(--ancho-max);
		margin-inline: auto;
	}

	.cabecera-titulo {
		font-size: clamp(4rem, 1.5rem + 11vw, 11rem);
		line-height: 0.88;
	}

	.cabecera-entrada {
		max-width: 34ch;
		font-size: var(--t-md);
		line-height: 1.4;
	}
</style>
