---
/**
 * El patio con la parrilla de leña (no hay terraza aparte).
 * Collage sobre barro: foto grande con marco desplazado, el parrillero
 * superpuesto y la palabra "Patio" en contorno cruzando la foto.
 * En celular, el botón fijo dice "Reservar en el patio" con su nota.
 */
import Foto from '../../ui/Foto.astro';
import patio from '../../../assets/photos/patio/espacios/restaurante-copal.webp';
import parrillero from '../../../assets/photos/cocina/espacios/parrillero-parrilla-lena.webp';
import type { Lang } from '../../../i18n/routes';
import { useTranslations } from '../../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
	class="patio"
	aria-labelledby="patio-titulo"
	data-fondo="barro"
	data-espacio-reservar={t('reservar.patio')}
	data-espacio-nota={t('reservar.notaEspacio')}
>
	<div class="patio-foto marco marco--arriba-der revela">
		<Foto src={patio} alt={t('inicio.patio.alt')} sizes="(min-width: 64rem) 50vw, 92vw" class="patio-img" />
	</div>

	<p class="patio-contorno voz-cocina" aria-hidden="true">{t('inicio.patio.palabra')}</p>

	<div class="patio-parrilla marco marco--abajo-izq enciende revela">
		<Foto src={parrillero} alt={t('inicio.parrilla.alt')} sizes="(min-width: 64rem) 22vw, 52vw" class="patio-img" />
	</div>

	<div class="patio-texto">
		<h2 id="patio-titulo" class="voz-cocina">{t('inicio.patio.titulo')}</h2>
		<p>{t('inicio.patio.texto')}</p>
	</div>
</section>

<style>
	.patio {
		position: relative;
		display: grid;
		gap: var(--e-6);
		padding: var(--e-9) var(--margen-lateral);
		background-color: var(--c-barro);
		overflow: hidden;
	}

	.patio :global(.patio-img) {
		width: 100%;
		height: 100%;
	}

	.patio-foto {
		width: 92%;
		aspect-ratio: 4 / 5;
	}

	/* "Patio" en contorno: dibuja sobre la foto sin taparla. */
	.patio-contorno {
		position: absolute;
		inset-inline-start: var(--margen-lateral);
		inset-block-start: 38%;
		z-index: 4;
		max-width: none;
		font-size: clamp(5rem, 2rem + 14vw, 15rem);
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 1.5px var(--c-copal);
		opacity: 0.85;
		pointer-events: none;
	}

	.patio-parrilla {
		width: 52%;
		aspect-ratio: 3 / 4;
		justify-self: end;
		margin-block-start: calc(-1 * var(--e-9));
		z-index: 5;
	}

	.patio-texto {
		display: grid;
		gap: var(--e-4);
	}

	.patio-texto h2 {
		font-size: clamp(2.4rem, 1.4rem + 4vw, 5rem);
	}

	.patio-texto p {
		max-width: var(--medida-estrecha);
	}

	@media (min-width: 64rem) {
		.patio {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			align-items: start;
		}

		.patio-foto {
			grid-column: 1 / span 6;
			grid-row: 1 / span 2;
			width: 100%;
		}

		.patio-contorno {
			inset-block-start: 30%;
		}

		.patio-parrilla {
			grid-column: 6 / span 3;
			grid-row: 2;
			width: 100%;
			margin: 0;
			align-self: end;
			transform: translateY(var(--e-8));
		}

		.patio-texto {
			grid-column: 9 / span 4;
			grid-row: 1;
			padding-block-start: var(--e-8);
		}
	}
</style>
