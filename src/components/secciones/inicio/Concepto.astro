---
/**
 * "De la costa a la sierra": el concepto de Copal.
 * La foto del humo de copal recortada con la forma de una elipse de la hoja;
 * el titular mezcla romana e itálica, y una cita en itálica fina.
 */
import Foto from '../../ui/Foto.astro';
import humo from '../../../assets/photos/ambiente/copal.webp';
import type { Lang } from '../../../i18n/routes';
import { useTranslations } from '../../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="concepto" aria-labelledby="concepto-titulo" data-fondo="noche">
	<div class="concepto-foto mascara-hoja revela">
		<Foto
			src={humo}
			alt={t('inicio.concepto.alt')}
			sizes="(min-width: 64rem) 32vw, 80vw"
			class="concepto-img"
		/>
	</div>
	<div class="concepto-texto">
		<h2 id="concepto-titulo" class="concepto-titular voz-marca">
			<span>{t('inicio.concepto.linea1')}</span>
			<span class="italica">{t('inicio.concepto.linea2')}</span>
		</h2>
		<p class="concepto-cita italica">{t('inicio.concepto.texto1')}</p>
		<p class="concepto-fuego">{t('inicio.concepto.texto2')}</p>
	</div>
</section>

<style>
	.concepto {
		display: grid;
		gap: var(--e-6);
		max-width: var(--ancho-max);
		margin-inline: auto;
		padding: var(--e-9) var(--margen-lateral);
	}

	.concepto-foto {
		width: min(80vw, 30rem);
		aspect-ratio: 1;
		justify-self: center;
	}

	.concepto-foto :global(.concepto-img) {
		width: 100%;
		height: 100%;
	}

	.concepto-texto {
		display: grid;
		gap: var(--e-5);
	}

	.concepto-titular {
		display: grid;
		font-size: clamp(3rem, 1.6rem + 6vw, 7.5rem);
		line-height: 0.92;
	}

	.concepto-titular .italica {
		padding-inline-start: 1.2em;
		color: var(--c-farol);
	}

	.concepto-cita {
		max-width: 26ch;
		font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem);
		line-height: 1.2;
	}

	.concepto-fuego {
		max-width: var(--medida-estrecha);
		color: var(--texto-suave);
	}

	@media (min-width: 64rem) {
		.concepto {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: center;
			column-gap: var(--e-8);
		}

		.concepto-foto {
			width: 100%;
		}
	}
</style>
