---
/**
 * Página Cocina (recibe el idioma).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/secciones/CabeceraPagina.astro';
import ReservaBlock from '../components/reserva/ReservaBlock.astro';
import type { Lang } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="cocina" title={t('cocina.titulo')} description={t('cocina.meta')}>
	<CabeceraPagina titulo={t('cocina.titulo')} entrada={t('cocina.lead')} voz="voz-cocina" />
	<ReservaBlock lang={lang} />
</BaseLayout>
